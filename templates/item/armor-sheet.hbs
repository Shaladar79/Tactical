<div class="tactical item-sheet armor-sheet {{cssClass}}">

  <header class="sheet-header">

    <div class="header-top armor-header-top">

      <div class="header-portrait">

        <img
          class="profile-img"
          src="{{item.img}}"
          data-edit="img"
          title="{{item.name}}"
          width="96"
          height="96"
        >

      </div>

      <div class="header-identity armor-header-identity">

        {{!-- ------------------------------------ --}}
        {{!--  Name Row                             --}}
        {{!-- ------------------------------------ --}}

        <div class="identity-field armor-name-field">

          <label>Name</label>

          <input
            name="name"
            type="text"
            value="{{item.name}}"
            placeholder="Armor Name"
          >

        </div>

        {{!-- ------------------------------------ --}}
        {{!--  Classification Row                   --}}
        {{!-- ------------------------------------ --}}

        <div class="armor-classification-row">

          <div class="identity-field">

            <label>Armor Type</label>

            <input
              name="system.armorType"
              type="text"
              value="{{classification.armorType}}"
              placeholder="body, shield..."
            >

          </div>

          <div class="identity-field">

            <label>Technology Type</label>

            <input
              name="system.technologyType"
              type="text"
              value="{{classification.technologyType}}"
              placeholder="Technology Type"
            >

          </div>

          <div class="identity-field armor-slot-field">

            <label>Slot</label>

            <input
              name="system.slot"
              type="text"
              value="{{classification.slot}}"
            >

          </div>

        </div>

      </div>

    </div>

  </header>

  {{!-- ---------------------------------------- --}}
  {{!--  Tabs                                     --}}
  {{!-- ---------------------------------------- --}}

  <nav class="armor-sheet-tabs">

    {{#each tabs as |tab|}}

      <button
        type="button"
        class="armor-tab-button {{#if tab.active}}active{{/if}}"
        data-action="switchTab"
        data-tab="{{tab.id}}"
      >
        {{tab.label}}
      </button>

    {{/each}}

  </nav>

  <section class="sheet-body armor-sheet-body">

    {{!-- ---------------------------------------- --}}
    {{!--  Protection Tab                          --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.0.active}}

      <section
        class="item-section armor-tab-panel"
        data-tab-panel="protection"
      >

        <h2>Protection</h2>

        <div class="item-field-grid">

          <div class="item-field">

            <label>Toughness</label>

            <input
              name="system.toughness"
              type="number"
              min="0"
              step="1"
              value="{{protection.toughness}}"
            >

          </div>

          <div class="item-field">

            <label>Maximum Integrity</label>

            <input
              name="system.integrityMax"
              type="number"
              min="0"
              step="1"
              value="{{protection.integrityMax}}"
            >

          </div>

        </div>

        <p class="hint">
          Toughness reduces incoming damage after Penetration.
          Armor Integrity absorbs remaining damage before Health.
        </p>

      </section>

    {{/if}}

    {{!-- ---------------------------------------- --}}
    {{!--  Logistics Tab                           --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.1.active}}

      <section
        class="item-section armor-tab-panel"
        data-tab-panel="logistics"
      >

        <h2>Logistics</h2>

        <div class="item-field-grid">

          <div class="item-field">

            <label>Supply Value</label>

            <input
              name="system.supplyValue"
              type="number"
              min="0"
              step="1"
              value="{{logistics.supplyValue}}"
            >

          </div>

        </div>

      </section>

    {{/if}}

    {{!-- ---------------------------------------- --}}
    {{!--  Traits Tab                              --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.2.active}}

      <section
        class="item-section armor-tab-panel"
        data-tab-panel="traits"
      >

        <h2>Traits</h2>

        <p class="hint">
          Traits are stored as an array. Direct trait editing UI
          will be expanded later.
        </p>

        {{#if traits.length}}

          <div class="trait-list">

            {{#each traits as |trait|}}

              <span class="trait-tag">
                {{trait}}
              </span>

            {{/each}}

          </div>

        {{else}}

          <p class="hint">
            No Traits.
          </p>

        {{/if}}

      </section>

    {{/if}}

    {{!-- ---------------------------------------- --}}
    {{!--  Restrictions Tab                        --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.3.active}}

      <section
        class="item-section armor-tab-panel"
        data-tab-panel="restrictions"
      >

        <h2>Restrictions & Source</h2>

        <div class="item-field-grid">

          <div class="item-field checkbox-field">

            <label>Restricted</label>

            <input
              name="system.restricted"
              type="checkbox"
              {{checked restrictions.restricted}}
            >

          </div>

          <div class="item-field">

            <label>Source Module</label>

            <input
              name="system.sourceModule"
              type="text"
              value="{{restrictions.sourceModule}}"
            >

          </div>

        </div>

      </section>

    {{/if}}

  </section>

</div>
