<div class="tactical actor-sheet vehicle-sheet {{cssClass}}">

  <header class="sheet-header">

    <div class="header-top vehicle-header-top">

      <div class="header-portrait">

        <img
          class="profile-img"
          src="{{actor.img}}"
          data-edit="img"
          title="{{actor.name}}"
          width="96"
          height="96"
        >

      </div>

      <div class="header-identity vehicle-header-identity">

        {{!-- ------------------------------------ --}}
        {{!--  Name Row                             --}}
        {{!-- ------------------------------------ --}}

        <div class="identity-field vehicle-name-field">

          <label>Name</label>

          <input
            name="name"
            type="text"
            value="{{actor.name}}"
            placeholder="Vehicle Name"
          >

        </div>

        {{!-- ------------------------------------ --}}
        {{!--  Progression / Classification         --}}
        {{!-- ------------------------------------ --}}

        <div class="vehicle-classification-row">

          <div class="identity-field">

            <label>Tier</label>

            <input
              name="system.tier"
              type="number"
              min="1"
              step="1"
              value="{{progression.tier}}"
            >

          </div>

          <div class="identity-field">

            <label>Rank</label>

            <input
              name="system.rank"
              type="number"
              min="0"
              step="1"
              value="{{progression.rank}}"
            >

          </div>

          <div class="identity-field checkbox-field vehicle-autonomous-field">

            <label>Autonomous</label>

            <input
              name="system.autonomous"
              type="checkbox"
              {{checked progression.autonomous}}
            >

          </div>

        </div>

      </div>

    </div>

  </header>

  {{!-- ---------------------------------------- --}}
  {{!--  Tabs                                     --}}
  {{!-- ---------------------------------------- --}}

  <nav class="vehicle-sheet-tabs">

    {{#each tabs as |tab|}}

      <button
        type="button"
        class="vehicle-tab-button {{#if tab.active}}active{{/if}}"
        data-action="switchTab"
        data-tab="{{tab.id}}"
      >
        {{tab.label}}
      </button>

    {{/each}}

  </nav>

  <section class="sheet-body vehicle-sheet-body">

    {{!-- ---------------------------------------- --}}
    {{!--  Combat Tab                              --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.0.active}}

      <section
        class="vehicle-tab-panel"
        data-tab-panel="combat"
      >

        <h3>Hull</h3>

        <div class="vehicle-resource-grid">

          <div class="item-field">

            <label>Current Hull</label>

            <input
              name="system.hull.value"
              type="number"
              min="0"
              step="1"
              value="{{combat.hull.value}}"
            >

          </div>

          <div class="item-field">

            <label>Base Maximum Hull</label>

            <input
              name="system.hull.max"
              type="number"
              min="0"
              step="1"
              value="{{combat.hull.max}}"
            >

          </div>

          <div class="item-field effective-field">

            <label>Effective Maximum Hull</label>

            <input
              type="number"
              value="{{effective.hull.max}}"
              readonly
            >

          </div>

        </div>

        <h3>Armor Integrity</h3>

        <div class="vehicle-resource-grid">

          <div class="item-field">

            <label>Current Integrity</label>

            <input
              name="system.armorIntegrity.value"
              type="number"
              min="0"
              step="1"
              value="{{combat.armorIntegrity.value}}"
            >

          </div>

          <div class="item-field">

            <label>Base Maximum Integrity</label>

            <input
              name="system.armorIntegrity.max"
              type="number"
              min="0"
              step="1"
              value="{{combat.armorIntegrity.max}}"
            >

          </div>

          <div class="item-field effective-field">

            <label>Effective Maximum Integrity</label>

            <input
              type="number"
              value="{{effective.armorIntegrity.max}}"
              readonly
            >

          </div>

        </div>

        <h3>Combat Statistics</h3>

        <div class="item-field-grid">

          <div class="item-field">

            <label>Base Movement</label>

            <input
              name="system.movement"
              type="number"
              min="0"
              step="1"
              value="{{combat.movement}}"
            >

          </div>

          <div class="item-field effective-field">

            <label>Effective Movement</label>

            <input
              type="number"
              value="{{effective.movement}}"
              readonly
            >

          </div>

          <div class="item-field">

            <label>Base Initiative</label>

            <input
              name="system.initiative"
              type="number"
              min="0"
              step="1"
              value="{{combat.initiative}}"
            >

          </div>

          <div class="item-field effective-field">

            <label>Effective Initiative</label>

            <input
              type="number"
              value="{{effective.initiative}}"
              readonly
            >

          </div>

          <div class="item-field">

            <label>Resolve</label>

            <input
              name="system.resolve"
              type="number"
              min="0"
              step="1"
              value="{{combat.resolve}}"
            >

          </div>

          <div class="item-field">

            <label>Base Toughness</label>

            <input
              name="system.toughness"
              type="number"
              min="0"
              step="1"
              value="{{combat.toughness}}"
            >

          </div>

          <div class="item-field effective-field">

            <label>Effective Toughness</label>

            <input
              type="number"
              value="{{effective.toughness}}"
              readonly
            >

          </div>

        </div>

        <p class="hint">
          Editable values are the Vehicle's stored base statistics.
          Effective values include all embedded Vehicle Module modifiers.
        </p>

      </section>

    {{/if}}

    {{!-- ---------------------------------------- --}}
    {{!--  Action Economy Tab                      --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.1.active}}

      <section
        class="vehicle-tab-panel"
        data-tab-panel="actions"
      >

        <div class="item-field-grid">

          <div class="item-field">

            <label>Base Actions</label>

            <input
              name="system.actions"
              type="number"
              min="0"
              step="1"
              value="{{actionEconomy.actions}}"
            >

          </div>

          <div class="item-field effective-field">

            <label>Effective Actions</label>

            <input
              type="number"
              value="{{effective.actions}}"
              readonly
            >

          </div>

          <div class="item-field">

            <label>Base Reactions per Round</label>

            <input
              name="system.reactionsPerRound"
              type="number"
              min="0"
              step="1"
              value="{{actionEconomy.reactionsPerRound}}"
            >

          </div>

          <div class="item-field effective-field">

            <label>Effective Reactions per Round</label>

            <input
              type="number"
              value="{{effective.reactionsPerRound}}"
              readonly
            >

          </div>

        </div>

        <p class="hint">
          Effective Action Economy includes Vehicle Module modifiers.
        </p>

      </section>

    {{/if}}

    {{!-- ---------------------------------------- --}}
    {{!--  Attack Tab                              --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.2.active}}

      <section
        class="vehicle-tab-panel"
        data-tab-panel="attack"
      >

        <div class="item-field-grid">

          <div class="item-field">

            <label>Base Attack Pool</label>

            <input
              name="system.attackPool"
              type="number"
              min="0"
              step="1"
              value="{{attack.attackPool}}"
            >

          </div>

          <div class="item-field effective-field">

            <label>Effective Attack Pool</label>

            <input
              type="number"
              value="{{effective.attackPool}}"
              readonly
            >

          </div>

        </div>

        <p class="hint">
          Effective Attack Pool includes all Vehicle Module modifiers.
        </p>

      </section>

    {{/if}}

    {{!-- ---------------------------------------- --}}
    {{!--  Modules Tab                             --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.3.active}}

      <section
        class="vehicle-tab-panel vehicle-modules-panel"
        data-tab-panel="modules"
      >

        <p class="hint">
          Embedded Vehicle Modules automatically contribute their modifiers
          to this Vehicle's effective statistics.
        </p>

        <h3>Total Module Modifiers</h3>

        <div class="vehicle-module-summary-grid">

          <div class="vehicle-module-summary-card">
            <label>Hull</label>
            <span>{{moduleModifiers.hull}}</span>
          </div>

          <div class="vehicle-module-summary-card">
            <label>Armor Integrity</label>
            <span>{{moduleModifiers.armorIntegrity}}</span>
          </div>

          <div class="vehicle-module-summary-card">
            <label>Movement</label>
            <span>{{moduleModifiers.movement}}</span>
          </div>

          <div class="vehicle-module-summary-card">
            <label>Initiative</label>
            <span>{{moduleModifiers.initiative}}</span>
          </div>

          <div class="vehicle-module-summary-card">
            <label>Toughness</label>
            <span>{{moduleModifiers.toughness}}</span>
          </div>

          <div class="vehicle-module-summary-card">
            <label>Actions</label>
            <span>{{moduleModifiers.actions}}</span>
          </div>

          <div class="vehicle-module-summary-card">
            <label>Reactions</label>
            <span>{{moduleModifiers.reactions}}</span>
          </div>

          <div class="vehicle-module-summary-card">
            <label>Attack Pool</label>
            <span>{{moduleModifiers.attackPool}}</span>
          </div>

        </div>

        <h3>Installed Modules</h3>

        {{#if hasVehicleModules}}

          <div class="vehicle-module-list">

            {{#each vehicleModules as |module|}}

              <article class="vehicle-module-row">

                <img
                  class="vehicle-module-image"
                  src="{{module.img}}"
                  title="{{module.name}}"
                  width="42"
                  height="42"
                >

                <div class="vehicle-module-info">

                  <strong class="vehicle-module-name">
                    {{module.name}}
                  </strong>

                  <span class="vehicle-module-type">
                    {{module.moduleType}}
                  </span>

                  <div class="vehicle-module-controls">

                    <button
                      type="button"
                      class="vehicle-module-control"
                      data-action="openModule"
                      data-item-id="{{module.id}}"
                      title="Open Vehicle Module"
                    >
                      Edit
                    </button>

                    <button
                      type="button"
                      class="vehicle-module-control vehicle-module-remove"
                      data-action="deleteModule"
                      data-item-id="{{module.id}}"
                      title="Remove Vehicle Module"
                    >
                      Remove
                    </button>

                  </div>

                </div>

                <div class="vehicle-module-modifiers">

                  <span>Hull {{module.modifiers.hull}}</span>

                  <span>
                    Armor {{module.modifiers.armorIntegrity}}
                  </span>

                  <span>
                    Move {{module.modifiers.movement}}
                  </span>

                  <span>
                    Init {{module.modifiers.initiative}}
                  </span>

                  <span>
                    Tough {{module.modifiers.toughness}}
                  </span>

                  <span>
                    Actions {{module.modifiers.actions}}
                  </span>

                  <span>
                    Reactions {{module.modifiers.reactions}}
                  </span>

                  <span>
                    Attack {{module.modifiers.attackPool}}
                  </span>

                </div>

              </article>

            {{/each}}

          </div>

        {{else}}

          <p class="vehicle-modules-empty">
            No Vehicle Modules are currently embedded on this Vehicle.
          </p>

        {{/if}}

      </section>

    {{/if}}

  </section>

</div>
