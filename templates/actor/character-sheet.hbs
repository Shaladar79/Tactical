<form class="tactical character-sheet {{cssClass}}" autocomplete="off">

  <header class="sheet-header">

    <div class="header-top">

      <div class="header-portrait">

        <img
          class="profile-img"
          src="{{actor.img}}"
          data-edit="img"
          title="{{actor.name}}"
          width="96"
          height="96"
        >

      </div>

      <div class="header-identity">

        <div class="identity-field character-name-field">

          <label>Name</label>

          <input
            class="character-name"
            name="name"
            type="text"
            value="{{actor.name}}"
            placeholder="Character Name"
          >

        </div>

        <div class="identity-field">

          <label>Ancestry</label>

          <input
            name="system.ancestryId"
            type="text"
            value="{{system.ancestryId}}"
            placeholder="Ancestry"
          >

        </div>

        <div class="identity-field">

          <label>Archetype</label>

          <input
            name="system.archetypeId"
            type="text"
            value="{{system.archetypeId}}"
            placeholder="Archetype"
          >

        </div>

        <div class="header-progression">

          <div class="header-rank">

            <label>
              {{localize "TACTICAL.Progression.Rank"}}
            </label>

            <span class="derived-value">
              {{progression.rank}}
            </span>

          </div>

          <div class="header-rank-dice">

            <label>
              {{localize "TACTICAL.Progression.RankDice"}}
            </label>

            <div class="resource-values">

              <input
                name="system.rankDice.value"
                type="number"
                min="0"
                value="{{progression.rankDice.value}}"
              >

              <span>/</span>

              <span>
                {{progression.rankDice.max}}
              </span>

            </div>

          </div>

        </div>

      </div>

    </div>

    <div class="header-combat">

      <div class="header-resource">

        <label>
          {{localize "TACTICAL.Combat.Health"}}
        </label>

        <div class="resource-values">

          <input
            name="system.health.value"
            type="number"
            min="0"
            value="{{combat.health.value}}"
          >

          <span>/</span>

          <span>
            {{combat.health.max}}
          </span>

        </div>

      </div>

      <div class="header-resource">

        <label>
          {{localize "TACTICAL.Combat.Wounds"}}
        </label>

        <div class="resource-values">

          <input
            name="system.wounds.value"
            type="number"
            min="0"
            value="{{combat.wounds.value}}"
          >

          <span>/</span>

          <span>
            {{combat.wounds.max}}
          </span>

        </div>

      </div>

      <div class="header-resource">

        <label>
          {{localize "TACTICAL.Combat.ArmorIntegrity"}}
        </label>

        <div class="resource-values">

          <input
            name="system.armorIntegrity.value"
            type="number"
            min="0"
            value="{{combat.armorIntegrity.value}}"
          >

          <span>/</span>

          <input
            name="system.armorIntegrity.max"
            type="number"
            min="0"
            value="{{combat.armorIntegrity.max}}"
          >

        </div>

      </div>

      <div class="header-resource">

        <label>
          {{localize "TACTICAL.Combat.Toughness"}}
        </label>

        <input
          name="system.toughness"
          type="number"
          min="0"
          value="{{combat.toughness}}"
        >

      </div>

      <div class="header-resource">

        <label>
          {{localize "TACTICAL.Combat.Movement"}}
        </label>

        <span class="derived-value">
          {{combat.movement}}
        </span>

      </div>

    </div>

  </header>

  <nav class="sheet-tabs">

    {{#each tabs as |tab|}}

      <button
        type="button"
        class="sheet-tab-button {{#if tab.active}}active{{/if}}"
        data-action="switchTab"
        data-tab="{{tab.id}}"
      >
        {{tab.label}}
      </button>

    {{/each}}

  </nav>

  <section class="sheet-body">

    {{!-- ---------------------------------------- --}}
    {{!--  Combat Tab                              --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.0.active}}

      <section
        class="tab-panel combat-tab"
        data-tab-panel="combat"
      >

        <section class="combat-actions">

          <button
            type="button"
            class="stabilize-action"
            data-action="stabilize"
            title="Attempt to stabilize one targeted character"
          >
            Stabilize
          </button>

        </section>

        <section class="combat-loadout-section">

          <h2>Current Loadout</h2>

          <div class="weapon-list">

            {{#each weapons as |weapon|}}

              <div
                class="weapon-row"
                data-item-id="{{weapon.id}}"
              >

                <img
                  class="weapon-image"
                  src="{{weapon.img}}"
                  title="{{weapon.name}}"
                  width="32"
                  height="32"
                >

                <div class="weapon-name">
                  {{weapon.name}}
                </div>

                <div class="weapon-stat">
                  <span>DPS</span>
                  <strong>{{weapon.dps}}</strong>
                </div>

                <div class="weapon-stat">
                  <span>Pen</span>
                  <strong>{{weapon.penetration}}</strong>
                </div>

                <div class="weapon-stat">
                  <span>Range</span>
                  <strong>{{weapon.intendedRange}}</strong>
                </div>

                <div class="weapon-stat">
                  <span>Pool</span>
                  <strong>{{weapon.pool}}d12</strong>
                </div>

                {{#if weapon.usesMagazine}}

                  <div class="weapon-stat weapon-ammo">

                    <span>Ammo</span>

                    <strong>
                      {{weapon.ammoRemaining}}
                      /
                      {{weapon.magazineCapacity}}
                    </strong>

                  </div>

                {{else}}

                  <div class="weapon-stat weapon-ammo">

                    <span>Ammo</span>

                    <strong>—</strong>

                  </div>

                {{/if}}

                <div class="weapon-actions">

                  <button
                    type="button"
                    class="weapon-attack"
                    data-action="rollWeapon"
                    data-weapon="{{weapon.id}}"
                    title="Attack with {{weapon.name}}"
                  >
                    Attack
                  </button>

                  {{#unless (eq weapon.weaponType "melee")}}

                    <button
                      type="button"
                      class="weapon-overwatch"
                      data-action="overwatch"
                      data-weapon="{{weapon.id}}"
                      title="Enter Overwatch with {{weapon.name}}"
                    >
                      Overwatch
                    </button>

                  {{/unless}}

                  {{#if weapon.usesMagazine}}

                    <button
                      type="button"
                      class="weapon-reload"
                      data-action="reloadWeapon"
                      data-weapon="{{weapon.id}}"
                      title="Reload {{weapon.name}}"
                    >
                      Reload
                    </button>

                  {{/if}}

                </div>

              </div>

            {{else}}

              <p class="hint">
                This character has no Weapon Items.
              </p>

            {{/each}}

          </div>

        </section>

        <hr>

        <section class="combat-abilities-section">

          <h2>Usable Abilities</h2>

          <p class="hint">
            Usable abilities will appear here.
          </p>

        </section>

      </section>

    {{/if}}

    {{!-- ---------------------------------------- --}}
    {{!--  Attributes & Skills Tab                 --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.1.active}}

      <section
        class="tab-panel attributes-skills-tab"
        data-tab-panel="attributes"
      >

        <nav class="attribute-subtabs">

          {{#each attributeSubTabs as |tab|}}

            <button
              type="button"
              class="attribute-subtab-button {{#if tab.active}}active{{/if}}"
              data-action="switchAttributeSubTab"
              data-attribute-subtab="{{tab.id}}"
            >
              {{tab.label}}
            </button>

          {{/each}}

        </nav>

        {{!-- ------------------------------------ --}}
        {{!--  Attributes Sub-Tab                  --}}
        {{!-- ------------------------------------ --}}

        {{#if attributeSubTabs.0.active}}

          <section
            class="attribute-subtab-panel attributes-subtab"
            data-attribute-subtab-panel="attributes"
          >

            <section class="attributes-section">

              <h2>Attributes</h2>

              <div class="attribute-grid">

                {{#each attributes as |attribute|}}

                  <div class="attribute-card">

                    <button
                      type="button"
                      class="attribute-roll"
                      data-action="rollAttribute"
                      data-attribute="{{attribute.id}}"
                      title="Roll {{attribute.name}}"
                    >
                      {{attribute.name}}
                    </button>

                    <input
                      name="system.attributes.{{attribute.id}}"
                      type="number"
                      min="0"
                      step="1"
                      value="{{attribute.value}}"
                    >

                    <div class="attribute-pool">
                      {{attribute.value}}d12
                    </div>

                  </div>

                {{/each}}

              </div>

            </section>

          </section>

        {{/if}}

        {{!-- ------------------------------------ --}}
        {{!--  Skills Sub-Tab                      --}}
        {{!-- ------------------------------------ --}}

        {{#if attributeSubTabs.1.active}}

          <section
            class="attribute-subtab-panel skills-subtab"
            data-attribute-subtab-panel="skills"
          >

            <section class="skills-section">

              <h2>Skills</h2>

              <div class="skill-list">

                {{#each skills as |skill|}}

                  <div class="skill-row">

                    <button
                      type="button"
                      class="skill-roll"
                      data-action="rollSkill"
                      data-skill="{{skill.id}}"
                      title="Roll {{skill.name}}"
                    >
                      {{skill.name}}
                    </button>

                    <div class="skill-attribute">
                      {{skill.attribute}}
                      {{skill.attributeValue}}
                    </div>

                    <input
                      name="system.skills.{{skill.id}}"
                      type="number"
                      min="0"
                      step="1"
                      value="{{skill.value}}"
                    >

                    <div class="skill-pool">
                      {{skill.pool}}d12
                    </div>

                  </div>

                {{/each}}

              </div>

            </section>

          </section>

        {{/if}}

        {{!-- ------------------------------------ --}}
        {{!--  Saves Sub-Tab                       --}}
        {{!-- ------------------------------------ --}}

        {{#if attributeSubTabs.2.active}}

          <section
            class="attribute-subtab-panel saves-subtab"
            data-attribute-subtab-panel="resists"
          >

            <section class="saves-section">

              <h2>Saves</h2>

              <div class="skill-list">

                {{#each saves as |save|}}

                  <div class="skill-row save-row">

                    <div class="save-name">
                      <strong>{{save.name}}</strong>
                    </div>

                    <div class="skill-attribute">
                      {{save.name}}
                      {{save.attributeValue}}
                    </div>

                    <div class="save-bonus-field">

                      <label title="{{save.name}} Save Bonus">
                        {{save.abbreviation}}
                      </label>

                      <input
                        name="system.saveBonuses.{{save.id}}"
                        type="number"
                        min="0"
                        step="1"
                        value="{{save.bonus}}"
                      >

                    </div>

                    <div class="skill-pool">
                      {{save.pool}}d12
                    </div>

                  </div>

                {{/each}}

              </div>

              <p class="hint">
                Save Pool = Attribute + General Save Bonus. Conditional Save Bonuses are applied when the Save is resolved.
              </p>

            </section>

          </section>

        {{/if}}

      </section>

    {{/if}}

    {{!-- ---------------------------------------- --}}
    {{!--  Talents Tab                             --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.2.active}}

      <section
        class="tab-panel talents-tab"
        data-tab-panel="talents"
      >

        <h2>Talents</h2>

        <p class="hint">
          Character talents will appear here.
        </p>

      </section>

    {{/if}}

    {{!-- ---------------------------------------- --}}
    {{!--  Inventory Tab                           --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.3.active}}

      <section
        class="tab-panel inventory-tab"
        data-tab-panel="inventory"
      >

        <h2>Inventory</h2>

        <p class="hint">
          Character inventory and equipment management will appear here.
        </p>

      </section>

    {{/if}}

    {{!-- ---------------------------------------- --}}
    {{!--  Progression Tab                         --}}
    {{!-- ---------------------------------------- --}}

    {{#if tabs.4.active}}

      <section
        class="tab-panel progression-tab"
        data-tab-panel="progression"
      >

        <section class="progression-section">

          <h2>Progression</h2>

          <div class="progression-summary">

            <div class="summary-field">

              <label>
                {{localize "TACTICAL.Progression.EarnedXP"}}
              </label>

              <input
                name="system.xp.earned"
                type="number"
                min="0"
                step="1"
                value="{{progression.earnedXP}}"
              >

            </div>

            <div class="summary-field">

              <label>
                {{localize "TACTICAL.Progression.SpentXP"}}
              </label>

              <span>
                {{progression.spentXP}}
              </span>

            </div>

            <div class="summary-field">

              <label>
                {{localize "TACTICAL.Progression.AvailableXP"}}
              </label>

              <span>
                {{progression.availableXP}}
              </span>

            </div>

          </div>

        </section>

      </section>

    {{/if}}

  </section>

</form>
